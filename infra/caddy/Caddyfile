{$DOMAIN} {
  encode zstd gzip
  handle /api/* {
    reverse_proxy api:3000
  }
  handle {
    root * /srv
    try_files {path} /index.html
    header Cache-Control "no-cache"
    file_server
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
  }
}
:8080 {
  bind 127.0.0.1
  respond /health "ok" 200
}
