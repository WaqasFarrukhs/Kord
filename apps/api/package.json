{
  "name": "@kord/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts"
  },
  "dependencies": {
    "@kord/contracts": "workspace:*",
    "hono": "4.13.17",
    "@hono/node-server": "1.19.18",
    "drizzle-orm": "0.45.4",
    "pg": "8.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "tsx": "4.20.6",
    "tsup": "8.5.1",
    "drizzle-kit": "0.31.11"
  }
}
