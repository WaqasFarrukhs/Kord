{
  "expo": {
    "name": "Kord",
    "slug": "kord",
    "scheme": "kord",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.kord.client",
      "deploymentTarget": "17.0"
    },
    "android": {
      "package": "app.kord.client"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Kord"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
