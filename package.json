{
  "name": "kord",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.3 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @kord/api dev",
    "dev:web": "pnpm --filter @kord/client web",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @kord/api build && pnpm --filter @kord/client build",
    "db:generate": "pnpm --filter @kord/api db:generate",
    "db:migrate": "pnpm --filter @kord/api db:migrate"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "@playwright/test": "1.65.0",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1"
  }
}
